# Browser-safe Supabase project values. Never place service-role secrets in Vite variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Leave VITE_API_URL empty locally to use Vite's same-origin development proxy.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Keep false outside intentional demos and deterministic browser tests.
VITE_DEMO_FALLBACK=false
