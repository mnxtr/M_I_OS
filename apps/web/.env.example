# --- Supabase (browser-visible) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (server only — NEVER prefix with NEXT_PUBLIC_) --------------------
# Used for signed upload URLs, admin invites, and reading objects on behalf of the API.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- MIOS API ------------------------------------------------------------------
# Public origin of the FastAPI service. The browser streams SSE directly from it,
# so it must be reachable from the client and CORS-allow this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional private origin for server-side calls (route handlers / RSC).
# Falls back to NEXT_PUBLIC_API_URL when unset.
API_INTERNAL_URL=

# --- This app ------------------------------------------------------------------
# Must exactly match an entry in Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Feature flags -------------------------------------------------------------
# Audit-log UI ships dark until the backing table exists (Phase-A security deliverable).
NEXT_PUBLIC_FEATURE_AUDIT_LOG=false
# Quality Intelligence (D-4) shell.
NEXT_PUBLIC_FEATURE_QUALITY=false

# --- Observability (optional) --------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
