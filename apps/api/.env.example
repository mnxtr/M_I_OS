# Lineora API development environment. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://mios:mios_dev@localhost:5432/mios
JWT_SECRET=change-me-in-production
STORAGE_DIR=./storage
DEV_BOOTSTRAP_SCHEMA=false
PRODUCTION_DRAFTS_ENABLED=false
# Enable only after the production_drafts migration and runtime-role verification.
# Enable bootstrap only against a disposable local database; use migrations remotely.
AUTH_PROVIDER=legacy
# For the connected deployment, set AUTH_PROVIDER=supabase and provision memberships.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=["http://localhost:5173"]

# Embeddings: openai | local (local = deterministic dev fallback, low quality)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# LLM: grok | openai | anthropic | none (none = extractive fallback)
LLM_PROVIDER=grok
XAI_API_KEY=
XAI_MODEL=
ANTHROPIC_API_KEY=

# Workers: USE_CELERY=true requires Redis + celery extra
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Sandbox only in this release; real subscription activation is disabled.
PAYMENT_SANDBOX_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
API_PUBLIC_BASE_URL=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3000
USD_TO_BDT_RATE=120.0
