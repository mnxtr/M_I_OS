# MIOS API environment
DATABASE_URL=postgresql+psycopg://mios:mios_dev@localhost:5432/mios
JWT_SECRET=change-me-in-production
STORAGE_DIR=./storage

# Embeddings: openai | local (local = deterministic dev fallback, low quality)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# LLM: openai | anthropic | none (none = extractive fallback)
# D-1 decision: OpenAI-primary; GPT-4o-mini class default, frontier for synthesis
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=

# Workers: USE_CELERY=true requires Redis + celery extra
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Payments (D-3: bKash-first). Sandbox base URL shown; swap for production.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3000
USD_TO_BDT_RATE=120.0
