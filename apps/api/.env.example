# MIOS API environment
DATABASE_URL=
JWT_SECRET=
STORAGE_DIR=./storage

# Supabase identity. Leave SUPABASE_URL empty only for legacy local password auth.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_AUDIENCE=authenticated
SUPABASE_AUTO_PROVISION_PILOT=false
AUTO_CREATE_SCHEMA=false

# Embeddings: openai | local (local = deterministic dev fallback, low quality)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_STORE_RESPONSES=false

# LLM: openai | anthropic | none (none = extractive fallback)
# D-1 decision: OpenAI-primary; Terra balances intelligence and pilot cost.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=

# Workers: USE_CELERY=true requires Redis + celery extra
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Payments (D-3: bKash-first). Sandbox base URL shown; swap for production.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3000
USD_TO_BDT_RATE=120.0
