# MIOS API environment
DATABASE_URL=postgresql+psycopg://mios:mios_dev@localhost:5432/mios
JWT_SECRET=change-me-in-production
STORAGE_DIR=./storage

# Embeddings: openai | local (local = deterministic dev fallback, low quality)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# LLM: openai | anthropic | none (none = extractive fallback)
# D-1 decision: OpenAI-primary; GPT-4o-mini class default, frontier for synthesis
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=

# Workers: USE_CELERY=true requires Redis + celery extra
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
